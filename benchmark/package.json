{
  "name": "let-it-go-worker-benchmark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "pnpm --dir .. exec eslint --config benchmark/eslint.config.js benchmark/src benchmark/tests",
    "type-check": "tsc --noEmit",
    "test:functional": "playwright test tests/functional.spec.ts",
    "benchmark:chromium": "playwright test tests/performance.spec.ts --project=chromium"
  },
  "dependencies": {
    "let-it-go": "link:.."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  }
}
