{
  "name": "let-it-go",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.1.0",
  "description": "❄️ Let your website snow instantly",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest ./tests",
    "type-check": "tsc --noEmit",
    "type-check:watch": "pnpm type-check --watch",
    "build:types": "tsc --emitDeclarationOnly && rollup -c rollup.types.config.js && rimraf dist/types",
    "build:js": "rollup -c",
    "build": "rimraf dist && pnpm build:types && pnpm build:js",
    "lint": "eslint src",
    "lint:fix": "pnpm lint --fix",
    "prepare": "husky install",
    "prepublishOnly": "pnpm build",
    "release:check": "node scripts/check-release-version.mjs",
    "release": "pnpm release:check && standard-version && pnpm release:check",
    "demo:dev": "pnpm build && pnpm -C demo dev"
  },
  "keywords": [
    "let-it-go",
    "snow",
    "snowfall",
    "canvas"
  ],
  "author": "Michael Wang <hi@eastsun.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EastSun5566/let-it-go"
  },
  "homepage": "https://eastsun5566.github.io/let-it-go/",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.24.7",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@stylistic/eslint-plugin": "^3.0.0",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-extended": "^2.3.3",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-n": "^17.0.0",
    "husky": "^8.0.3",
    "jsdom": "^25.0.1",
    "rimraf": "^3.0.2",
    "rollup": "^4.54.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-filesize": "^9.1.2",
    "standard-version": "^9.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.0"
  }
}
